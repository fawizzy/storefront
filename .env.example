# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed when self-hosting behind a proxy / not on Vercel
AUTH_TRUST_HOST=true

# Comma-separated Google emails that can open /dashboard
ADMIN_EMAILS=you@example.com

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxx

# Public URL of the site, used for the Paystack callback URL
APP_URL=http://localhost:3000

NEXT_PUBLIC_STORE_NAME=Kòkó Market
NEXT_PUBLIC_STORE_CURRENCY=NGN
# Flat shipping fee in kobo (150000 = ₦1,500)
SHIPPING_FEE_KOBO=150000

# Email (any SMTP provider). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password from myaccount.google.com/apppasswords>
# Leave empty to skip sending emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional; defaults to "<store name> <SMTP_USER>"
EMAIL_FROM=

# Turso database (https://turso.tech). Required on Vercel.
# Leave empty locally to use a SQLite file at data/store.db instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
