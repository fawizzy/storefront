# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed when self-hosting behind a proxy / not on Vercel
AUTH_TRUST_HOST=true

# Comma-separated Google emails that can open /dashboard
ADMIN_EMAILS=you@example.com

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxx

# Public URL of the site, used for the Paystack callback URL
APP_URL=http://localhost:3000

NEXT_PUBLIC_STORE_NAME=Kòkó Market
NEXT_PUBLIC_STORE_CURRENCY=NGN
# Flat shipping fee in kobo (150000 = ₦1,500)
SHIPPING_FEE_KOBO=150000
